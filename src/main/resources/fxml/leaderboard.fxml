<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<VBox xmlns:fx="http://javafx.com/fxml/1" alignment="TOP_CENTER" prefHeight="620.0" prefWidth="560.0"
      style="-fx-background-color: #3d1a0a;" xmlns="http://javafx.com/javafx/21"
      fx:controller="it.polimi.ingsw.am23.view.gui.controllers.LeaderboardController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label fx:id="titleLabel" text="Global leaderboard" textFill="#f5f0e8">
        <font>
            <Font name="System Bold" size="18.0"/>
        </font>
        <VBox.margin>
            <Insets bottom="6.0"/>
        </VBox.margin>
    </Label>
    <Label fx:id="subtitleLabel" textFill="#e0d6c4">
        <font>
            <Font name="System Italic" size="12.0"/>
        </font>
        <VBox.margin>
            <Insets bottom="14.0"/>
        </VBox.margin>
    </Label>
    <ScrollPane fitToWidth="true" prefHeight="460.0" prefWidth="520.0"
                style="-fx-background: transparent; -fx-background-color: transparent;">
        <VBox fx:id="entriesContainer" spacing="6.0"/>
    </ScrollPane>
    <Button mnemonicParsing="false" onAction="#onBackClicked" prefHeight="35.0"
            style="-fx-background-color: #ff4444; -fx-text-fill: #f5f0e8;" text="Back to results">
        <font>
            <Font name="System Bold" size="12.0"/>
        </font>
        <VBox.margin>
            <Insets top="16.0"/>
        </VBox.margin>
    </Button>
</VBox>
