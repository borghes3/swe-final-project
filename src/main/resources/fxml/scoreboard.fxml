<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox fx:id="rootContainer" alignment="CENTER" maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity"
      minWidth="-Infinity" prefHeight="620.0" prefWidth="420.0" style="-fx-background-color: #3d1a0a;"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="it.polimi.ingsw.am23.view.gui.controllers.ScoreboardController">
   <Label fx:id="titleLabel" text="GAME OVER " textFill="#f5f0e8">
      <font>
         <Font name="System Bold" size="18.0"/>
      </font>
      <VBox.margin>
         <Insets bottom="15.0"/>
      </VBox.margin>
   </Label>
   <VBox fx:id="rankingContainer" prefHeight="200.0" prefWidth="100.0">
      <VBox.margin>
         <Insets left="5.0" right="5.0"/>
      </VBox.margin>
   </VBox>
   <Label fx:id="positionLabel" text="Global leaderboard incoming..." textFill="#f5f0e8" wrapText="true"
          alignment="CENTER" textAlignment="CENTER" prefWidth="380.0">
      <font>
         <Font name="System Italic" size="13.0"/>
      </font>
      <VBox.margin>
         <Insets top="20.0" left="20.0" right="20.0"/>
      </VBox.margin>
   </Label>
   <Button fx:id="leaderboardButton" alignment="CENTER" disable="true" mnemonicParsing="false"
           onAction="#onLeaderboardClicked" prefHeight="35.0"
           style="-fx-background-color: #b6651e; -fx-text-fill: #f5f0e8;" text="View full leaderboard"
           textAlignment="CENTER">
      <font>
         <Font name="System Bold" size="12.0"/>
      </font>
      <VBox.margin>
         <Insets top="10.0"/>
      </VBox.margin>
   </Button>
   <Button fx:id="menuButton" alignment="CENTER" mnemonicParsing="false" onAction="#onMenuClicked" prefHeight="35.0"
           style="-fx-background-color: #ff4444; -fx-text-fill: #f5f0e8;" text="Back to Lobby" textAlignment="CENTER">
      <font>
         <Font name="System Bold" size="12.0"/>
      </font>
      <VBox.margin>
         <Insets top="10.0"/>
      </VBox.margin>
   </Button>
</VBox>
