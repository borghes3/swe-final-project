<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootStack"
           minHeight="800.0"
           minWidth="1100.0"
           xmlns="http://javafx.com/javafx/26"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="it.polimi.ingsw.am23.view.gui.controllers.GameScreenController">

    <children>

        <!-- BACKGROUND IMAGE LAYER -->
        <ImageView fx:id="backgroundImageView"
                   preserveRatio="false"
                   smooth="true"
                   cache="true"
                   pickOnBounds="true" />

        <!-- MAIN UI LAYER -->
        <BorderPane fx:id="rootPane"
                    minHeight="800.0"
                    minWidth="1100.0"
                    style="-fx-background-color: transparent;">

            <!-- TOP BAR -->
            <top>
                <HBox alignment="CENTER_LEFT"
                      spacing="20.0"
                      style="
                          -fx-background-color: rgba(24,8,4,0.62);
                          -fx-border-color: rgba(245,240,232,0.10);
                          -fx-border-width: 0 0 1 0;
                          -fx-padding: 8 16 8 16;
                      ">
                    <children>
                        <Label fx:id="eraLabel" text="Era I" textFill="#f5f0e8">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label fx:id="roundLabel" text="Round 1 / 10" textFill="#f5f0e8">
                            <font>
                                <Font size="14.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />

                        <Label fx:id="phaseLabel" text="Fase: -" textFill="#f5f0e8">
                            <font>
                                <Font size="13.0" />
                            </font>
                        </Label>

                        <Region HBox.hgrow="ALWAYS" />
                    </children>
                </HBox>
            </top>

            <!-- CENTER: BOARD -->
            <center>
                <VBox fx:id="boardRoot"
                      alignment="TOP_CENTER"
                      spacing="4.0"
                      style="
                          -fx-background-color: rgba(36,12,6,0.28);
                          -fx-background-radius: 0;
                      "
                      BorderPane.alignment="CENTER">

                    <padding>
                        <Insets bottom="4.0" left="16.0" right="16.0" top="8.0" />
                    </padding>

                    <children>

                        <!-- FILA SUPERIORE -->
                        <ScrollPane fitToHeight="true"
                                    fitToWidth="true"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    style="
                                        -fx-background: transparent;
                                        -fx-background-color: transparent;
                                    "
                                    VBox.vgrow="ALWAYS">
                            <content>
                                <HBox fx:id="topRowContainer"
                                      alignment="CENTER"
                                      minHeight="150.0"
                                      spacing="8.0"
                                      style="-fx-padding: 2 0 2 0;" />
                            </content>
                        </ScrollPane>

                        <!-- SUMMARYCARD | MAZZO | ORDINE TURNO | TRACCIATO OFFERTE -->
                        <HBox fx:id="boardTrackContainer"
                              alignment="CENTER"
                              spacing="16.0"
                              maxWidth="-Infinity">

                            <padding>
                                <Insets bottom="2.0" top="2.0" />
                            </padding>

                            <children>

                                <!-- SUMMARY BUTTON -->
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <StackPane fx:id="summaryButton"
                                                   prefHeight="110.0"
                                                   prefWidth="75.0"
                                                   style="
                       -fx-background-color: rgba(107,58,31,0.55);
                       -fx-background-radius: 8;
                       -fx-border-color: rgba(245,240,232,0.50);
                       -fx-border-radius: 8;
                       -fx-border-width: 1;
                       -fx-cursor: hand;
                   ">
                                            <children>
                                                <VBox alignment="CENTER" spacing="4.0">
                                                    <children>
                                                        <Label text="SUMMARY"
                                                               textFill="#f5f0e8"
                                                               style="-fx-font-size: 10px; -fx-opacity: 0.75;" />
                                                        <Label text="CARDS"
                                                               textFill="#f5f0e8"
                                                               style="-fx-font-size: 10px; -fx-opacity: 0.75;" />

                                                    </children>
                                                </VBox>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <!-- MAZZO -->
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <StackPane fx:id="deckContainer"
                                                   prefHeight="110.0"
                                                   prefWidth="75.0"
                                                   style="
                                                       -fx-background-color: rgba(107,58,31,0.76);
                                                       -fx-background-radius: 8;
                                                       -fx-border-color: rgba(245,240,232,0.75);
                                                       -fx-border-radius: 8;
                                                       -fx-border-width: 1;
                                                   ">
                                            <children>
                                                <Label fx:id="deckCountLabel"
                                                       text="?"
                                                       textFill="#f5f0e8">
                                                    <font>
                                                        <Font name="System Bold" size="16.0" />
                                                    </font>
                                                </Label>
                                            </children>
                                        </StackPane>
                                    </children>
                                </VBox>

                                <!-- ORDINE TURNO -->
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                       <!-- The real visual node is created by TurnOrderNodeFactory. -->
                                        <VBox fx:id="turnOrderContainer"
                                              alignment="CENTER"
                                              minHeight="110.0"
                                              prefWidth="100.0"
                                              spacing="0.0"
                                              style="
                                                  -fx-background-color: transparent;
                                                  -fx-padding: 0;
                                              " />
                                    </children>
                                </VBox>

                                <!-- TRACCIATO OFFERTE -->
                                <VBox alignment="CENTER" spacing="0.0">
                                    <children>
                                        <HBox fx:id="offerTilesContainer"
                                              alignment="CENTER"
                                              minHeight="110.0"
                                              spacing="6.0"
                                              maxWidth="-Infinity" />
                                    </children>
                                </VBox>

                            </children>
                        </HBox>

                        <!-- FILA INFERIORE -->
                        <ScrollPane fitToHeight="true"
                                    fitToWidth="true"
                                    hbarPolicy="AS_NEEDED"
                                    vbarPolicy="NEVER"
                                    style="
                                        -fx-background: transparent;
                                        -fx-background-color: transparent;
                                    "
                                    VBox.vgrow="ALWAYS">
                            <content>
                                <HBox fx:id="bottomRowContainer"
                                      alignment="CENTER"
                                      minHeight="150.0"
                                      spacing="8.0"
                                      style="-fx-padding: 2 0 2 0;" />
                            </content>
                        </ScrollPane>

                    </children>
                </VBox>
            </center>

            <!-- BOTTOM: PLAYER TRIBES -->
            <bottom>
                <VBox style="
                          -fx-background-color: rgba(18,6,3,0.68);
                          -fx-border-color: rgba(245,240,232,0.10);
                          -fx-border-width: 1 0 0 0;
                          -fx-padding: 8 16 12 16;
                      "
                      BorderPane.alignment="CENTER">
                    <children>
                        <Label style="-fx-font-size: 11px; -fx-padding: 0 0 6 0;"
                               text="TRIBE"
                               textFill="#f5f0e8" />

                        <FlowPane fx:id="playersContainer"
                                  alignment="CENTER"
                                  hgap="10.0"
                                  prefWrapLength="1400.0"
                                  vgap="10.0" />
                    </children>
                </VBox>
            </bottom>

        </BorderPane>

    </children>
</StackPane>